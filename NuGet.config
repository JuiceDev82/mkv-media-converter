<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Overrides the machine-level "jellyfin" source (repo.jellyfin.org), which
         now returns HTTP 410 Gone and fails restore for every project here. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
